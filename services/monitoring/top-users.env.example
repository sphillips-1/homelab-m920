# Copy to .top-users.env and never commit the populated file.
AUDIOBOOKSHELF_API_TOKEN="Bearer replace-with-an-admin-api-token"
TOP_USERS_WINDOW_DAYS=7
TOP_USERS_CACHE_SECONDS=300

# Map service-specific usernames to one display identity, if needed.
TOP_USERS_ALIASES='{"jellyfin-local-name":"person@example.com"}'
