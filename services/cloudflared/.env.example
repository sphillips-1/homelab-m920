# Local setup inputs. Copy to services/cloudflared/.env; keep it untracked.
# Domain only: do not include protocol or a hostname prefix.
CLOUDFLARE_DOMAIN=shelfgoblin.dev
# UUID produced by `cloudflared tunnel create homelab-m920`.
CLOUDFLARE_TUNNEL_ID=c347a8fe-fb14-49cc-acae-097d2ac42845
# Absolute path to that command's JSON credential file (secret).
CLOUDFLARE_TUNNEL_CREDENTIALS_FILE=/srv/homelab/appdata/cloudflared/00000000-0000-0000-0000-000000000000.json
