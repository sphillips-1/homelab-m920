# Copy to .env, set mode 0600, and never commit the real file.
AUTHENTIK_TAG=2026.5.6
PG_DB=authentik
PG_USER=authentik
# Generate with: openssl rand -base64 36 | tr -d '\n'
PG_PASS=replace-with-a-generated-value
# Generate with: openssl rand -base64 60 | tr -d '\n'
AUTHENTIK_SECRET_KEY=replace-with-a-generated-value

# Stable application/source credentials referenced by the Terraform-managed
# Authentik blueprint. Recover the existing values from the password manager;
# changing the Audiobookshelf value also requires updating Audiobookshelf.
AUTHENTIK_AUDIOBOOKSHELF_CLIENT_SECRET=replace-with-existing-oidc-client-secret
AUTHENTIK_GOOGLE_CLIENT_ID=replace-with-google-oauth-client-id
AUTHENTIK_GOOGLE_CLIENT_SECRET=replace-with-google-oauth-client-secret
# Complete Authentik expression policy source; keep personal allow-list values
# in this private variable rather than the committed blueprint.
AUTHENTIK_GOOGLE_EMAIL_ALLOWLIST_EXPRESSION='replace-with-reviewed-policy-expression'

# Invitation-specific secrets live in the separately protected and ignored
# .env.invitation file; start from .env.invitation.example.

# Listen on LAN and Tailscale interfaces for recovery. Never port-forward 9000.
AUTHENTIK_RECOVERY_BIND=0.0.0.0

# Optional automated first boot. Prefer the private initial-setup flow documented
# in README.md. If used, generate a hash with Authentik's hash_password command,
# single-quote it in .env, and remove both variables after first successful boot.
# AUTHENTIK_BOOTSTRAP_PASSWORD_HASH='replace-with-generated-django-password-hash'
# AUTHENTIK_BOOTSTRAP_EMAIL=you@example.com
